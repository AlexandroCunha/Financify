{
  "name": "financify",
  "version": "2.0.0",
  "description": "API REST para gerenciamento de finanças pessoais",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrar.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "postgresql",
    "financas-pessoais"
  ],
  "author": "Alexandro Cunha",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandroCunha/Financify.git"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  }
}
