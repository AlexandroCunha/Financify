# Copy this file to .env (or run "npm run setup", which also generates a random JWT_SECRET).
# Never commit .env.

NODE_ENV=development
PORT=3000

# The docker-compose database (port 5433 so it does not clash with a local PostgreSQL on 5432).
# With PostgreSQL installed on your machine, use something like:
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/financify
DATABASE_URL=postgres://financify:financify@localhost:5433/financify

# Optional: database used by the tests. Default: the same server, with "_test" added to the database name.
# DATABASE_URL_TEST=postgres://financify:financify@localhost:5433/financify_test

# Secret that signs the sign-in tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-value
JWT_EXPIRES_IN=1d

# Front-end addresses allowed by CORS, comma-separated.
CORS_ORIGIN=http://localhost:5173

# Sign-in attempts allowed per IP every 15 minutes (0 turns the limit off).
LOGIN_MAX_ATTEMPTS=10

# Demo accounts (POST /demo) each IP can create every 15 minutes (0 turns the limit off).
DEMO_MAX_PER_IP=5

# In production behind a proxy (Render, Railway, Fly.io...), use 1.
# TRUST_PROXY=1
