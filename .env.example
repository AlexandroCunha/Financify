# Copie este arquivo para .env (ou rode "npm run setup", que já gera um JWT_SECRET aleatório).
# Nunca faça commit do .env.

NODE_ENV=development
PORT=3000

# Banco do docker-compose (porta 5433 para não conflitar com um PostgreSQL local na 5432).
# Com o PostgreSQL instalado na máquina, use algo como:
# DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/financify
DATABASE_URL=postgres://financify:financify@localhost:5433/financify

# Opcional: banco usado pelos testes. Padrão: o mesmo servidor, com "_test" no nome do banco.
# DATABASE_URL_TEST=postgres://financify:financify@localhost:5433/financify_test

# Segredo que assina os tokens de login (mínimo de 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-este-valor
JWT_EXPIRES_IN=1d

# Endereços do front-end liberados no CORS, separados por vírgula.
CORS_ORIGIN=http://localhost:5173

# Tentativas de login permitidas por IP a cada 15 minutos (0 desliga o limite).
LOGIN_MAX_TENTATIVAS=10

# Em produção atrás de um proxy (Render, Railway, Fly.io...), use 1.
# TRUST_PROXY=1
